# Copy to .env.local for local development, and add the same values in
# Vercel under Settings > Environment Variables for the deployed site.
# .env files are gitignored, this example file is not.

# From resend.com > API Keys
RESEND_API_KEY=

# Where contact form messages get delivered.
CONTACT_TO_EMAIL=

# Optional. Only needed once a domain is verified with Resend.
# Without it the function sends from onboarding@resend.dev.
CONTACT_FROM_EMAIL=
